`verilator_config

public_flat_rw -module "tb_dport" -var "*"
public_flat_rw -module "tb_dport.i_mem_dport_axi" -var "*"
public_flat_rw -module "tb_dport.i_mem_dport_axi.i_mem_dport_mux" -var "*"

lint_off -rule WIDTHTRUNC     -file "*addrdecode.sv"
lint_off -rule WIDTHEXPAND    -file "*axi_ram_rd_if.v"
lint_off -rule WIDTHTRUNC     -file "*axi_ram_rd_if.v"
lint_off -rule WIDTHEXPAND    -file "*axi_ram_wr_if.v"
lint_off -rule WIDTHTRUNC     -file "*axi_ram_wr_if.v"
lint_off -rule CASEINCOMPLETE -file "*axi_ram_wr_if.v"
lint_off -rule WIDTHTRUNC     -file "*axil_ram.v"
