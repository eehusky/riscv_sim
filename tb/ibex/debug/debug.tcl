debug_level         1
adapter speed       10000
gdb port            3333
telnet port         4444
adapter driver      remote_bitbang
remote_bitbang host localhost
remote_bitbang port 44853
transport select    jtag

set _CHIPNAME riscv
jtag newtap $_CHIPNAME cpu -irlen 5 -expected-id 0x249511C3

foreach t [jtag names] {
    puts [format "TAP: %s\n" $t]
}

set _TARGETNAME $_CHIPNAME.cpu

target create $_TARGETNAME riscv -chain-position $_TARGETNAME
$_TARGETNAME configure -rtos FreeRTOS
#$_TARGETNAME configure -work-area-phys 0x80030000
#$_TARGETNAME configure -work-area-size 8096

riscv set_command_timeout_sec 2000
riscv virt2phys_mode off

scan_chain

#riscv_freertos_stacking metal

#flash bank $_CHIPNAME.sysrom read_only 0x800000000 0x40000 0 0 $_TARGETNAME

# prevent GDB from trying to tap these regisers to speed up halting and illegal instructions
